# Kopie nach C:\ProgramData\printtoqrview\backend.env - wird beim Start von
# cloudweb.exe (Dienst "CloudWeb") automatisch eingelesen (siehe
# internal/envfile), analog zu EnvironmentFile= unter systemd (Linux).

NC_BASE_URL=https://cloud.example.com
NC_USERNAME=change-cloud-user
NC_PASSWORD=changeme-app-passwort
#NC_TARGET_DIR=/PrinterUploads
#NC_LINK_EXPIRE_DAYS=1
# Länge des per fileshare.exe abgeleiteten Codes (Passwortschutz mit
# optionalem Namen) - Default 15, durch 5 teilbar für drei gleich lange,
# per Bindestrich getrennte Fünfer-Gruppen in der Anzeige.
#NC_LEN_CODE=15

# Anzeige-Server (siehe cmd/cloudweb): Listen-Adresse, Default ":40080".
#CLOUDWEB_LISTEN=:40080

# Von fileshare.exe (Explorer "Senden an") genutzt, um das Ergebnis an den
# lokal laufenden Dienst "CloudWeb" zu übergeben - Default
# "http://127.0.0.1:40080" passt zu CLOUDWEB_LISTEN oben und muss i. d. R.
# nicht geändert werden.
#CLOUDWEB_URL=http://127.0.0.1:40080
