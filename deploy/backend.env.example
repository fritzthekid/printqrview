# Kopie nach /etc/printtoqrview/backend.env (chmod 600, root:root).
# Wird vom Wrapper-Skript /usr/lib/cups/backend/nextcloud vor dem Aufruf des
# eigentlichen Backends eingelesen, da CUPS Backends mit minimaler Umgebung
# startet.

NC_BASE_URL=https://cloud.orthos.selfhost.eu
NC_USERNAME=printer
NC_PASSWORD=changeme-app-passwort
#NC_TARGET_DIR=/PrinterUploads
#NC_LINK_EXPIRE_DAYS=1

# "tmp" (Default) ist relativ zum Arbeitsverzeichnis des Backend-Prozesses -
# unter CUPS nicht das Projektverzeichnis. Für den Produktivbetrieb absolut
# setzen (vom install.sh-Skript angelegt):
PRINTTOQRVIEW_OUTPUT_DIR=/var/lib/printtoqrview/tmp

# Optionaler Ausgabe-Hook: wird nach jedem Erfolg als "<hook> <qr-png> <link>"
# aufgerufen, z. B. um den QR-Code auf einem angeschlossenen Display
# auszugeben (siehe raspi/). Ein Fehlschlag lässt den Druckjob nicht scheitern.
#PRINTTOQRVIEW_DISPLAY_HOOK=/usr/local/lib/printtoqrview/toraspi.sh
#RASPI_HOST=donar.local
#RASPI_DISPLAY_TIMEOUT=10
